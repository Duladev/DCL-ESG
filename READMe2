-- ---- Electricity Purchase CRUD ----
IF OBJECT_ID('dbo.sp_tblESG_SaveElectricityPurchase','P') IS NOT NULL DROP PROCEDURE dbo.sp_tblESG_SaveElectricityPurchase;
GO
CREATE PROCEDURE dbo.sp_tblESG_SaveElectricityPurchase
    @PurchaseID     INT = 0,
    @Year           SMALLINT,
    @Month          TINYINT,
    @PurchaseType   NVARCHAR(20),
    @PeakQty        DECIMAL(12,4),
    @NormalQty      DECIMAL(12,4),
    @OffPeakQty     DECIMAL(12,4),
    @PeakPaid       DECIMAL(14,2),
    @NormalPaid     DECIMAL(14,2),
    @OffPeakPaid    DECIMAL(14,2),
    @NewID          INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    IF @PurchaseID = 0
    BEGIN
        INSERT INTO dbo.tblESG_ElectricityPurchase
            (PurchaseYear,PurchaseMonth,PurchaseType,PeakQty_KWh,NormalQty_KWh,OffPeakQty_KWh,PeakPaid_LKR,NormalPaid_LKR,OffPeakPaid_LKR)
        VALUES
            (@Year,@Month,@PurchaseType,@PeakQty,@NormalQty,@OffPeakQty,@PeakPaid,@NormalPaid,@OffPeakPaid);
        SET @NewID = SCOPE_IDENTITY();
    END
    ELSE
    BEGIN
        UPDATE dbo.tblESG_ElectricityPurchase SET
            PurchaseYear=@Year, PurchaseMonth=@Month, PurchaseType=@PurchaseType,
            PeakQty_KWh=@PeakQty, NormalQty_KWh=@NormalQty, OffPeakQty_KWh=@OffPeakQty,
            PeakPaid_LKR=@PeakPaid, NormalPaid_LKR=@NormalPaid, OffPeakPaid_LKR=@OffPeakPaid,
            UpdatedAt=GETDATE()
        WHERE PurchaseID=@PurchaseID;
        SET @NewID = @PurchaseID;
    END
END
GO

