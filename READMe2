IF OBJECT_ID('dbo.sp_tblESG_GetElectricityPurchase','P') IS NOT NULL DROP PROCEDURE dbo.sp_tblESG_GetElectricityPurchase;
GO
CREATE PROCEDURE dbo.sp_tblESG_GetElectricityPurchase @Year SMALLINT=0, @Month TINYINT=0
AS
BEGIN
    SELECT e.*, (e.PeakPaid_LKR+e.NormalPaid_LKR+e.OffPeakPaid_LKR) AS TotalPaid_LKR
    FROM dbo.tblESG_ElectricityPurchase e
    WHERE (@Year=0 OR e.PurchaseYear=@Year)
      AND (@Month=0 OR e.PurchaseMonth=@Month)
    ORDER BY e.PurchaseYear DESC, e.PurchaseMonth DESC;
END
